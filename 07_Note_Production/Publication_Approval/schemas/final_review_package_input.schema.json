{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/note-final-review-package-input.schema.json",
  "title": "note Final Review Package Compiler Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_state", "article_id", "title", "d3_body", "marketing_review", "header", "publication_conditions", "destination", "purpose", "source_manifest"],
  "properties": {
    "schema_version": { "const": "note-final-review-package-input/v1" },
    "workflow_state": { "const": "MARKETING_APPROVED" },
    "article_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "d3_body": { "$ref": "#/$defs/local_artifact" },
    "marketing_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "identity", "version", "evidence"],
      "properties": {
        "status": { "const": "PASS" },
        "identity": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/local_artifact" }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "file", "local_path", "sha256", "asset_qa"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/input_sha256" },
        "asset_qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence"],
          "properties": {
            "status": { "const": "PASS" },
            "evidence": { "$ref": "#/$defs/local_artifact" }
          }
        }
      }
    },
    "publication_conditions": { "$ref": "#/$defs/publication_conditions" },
    "destination": { "$ref": "#/$defs/destination" },
    "purpose": { "const": "NOTE_PUBLICATION" },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "file", "local_path", "sha256"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/input_sha256" }
      }
    }
  },
  "$defs": {
    "input_sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "local_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "file", "local_path", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/input_sha256" }
      }
    },
    "publication_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_boundary", "membership", "magazine", "price", "tags", "other_conditions"],
      "properties": {
        "access_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "free_end_marker", "membership_start_marker"],
          "properties": {
            "mode": { "enum": ["FREE", "PAID", "MEMBERSHIP"] },
            "free_end_marker": { "type": "string", "minLength": 1 },
            "membership_start_marker": { "type": "string", "minLength": 1 }
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name", "plan"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" },
            "plan": { "type": "string" }
          }
        },
        "magazine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" }
          }
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "amount"],
          "properties": {
            "currency": { "const": "JPY" },
            "amount": { "type": "integer", "minimum": 0 }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "other_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "account_id", "publication_target"],
      "properties": {
        "service": { "const": "note" },
        "account_id": { "type": "string", "minLength": 1 },
        "publication_target": { "type": "string", "minLength": 1 }
      }
    }
  }
}

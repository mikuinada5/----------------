{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/note-final-review-package.schema.json",
  "title": "note Final Review Package v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "package_id",
    "identity_sha256",
    "state",
    "article_id",
    "title",
    "d3_body",
    "marketing_review",
    "header",
    "publication_conditions",
    "destination",
    "purpose",
    "source_manifest",
    "approval"
  ],
  "properties": {
    "schema_version": { "const": "note-final-review-package/v3" },
    "compiler_version": { "const": "note-final-review-package-compiler/v2" },
    "package_id": { "type": "string", "pattern": "^FRP-.+-[0-9a-f]{64}$" },
    "identity_sha256": { "$ref": "#/$defs/sha256" },
    "state": { "const": "READY_FOR_FINAL_REVIEW" },
    "article_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "d3_body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "file", "sha256", "content"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "marketing_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "identity", "version", "evidence"],
      "properties": {
        "status": { "const": "PASS" },
        "identity": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "display_title", "formal_asset_state", "formal_asset_identity_sha256", "file", "sha256", "master_template", "route_evidence", "asset_qa", "human_approval"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "display_title": { "type": "string", "minLength": 1 },
        "formal_asset_state": { "const": "FORMAL_HEADER_ASSET" },
        "formal_asset_identity_sha256": { "$ref": "#/$defs/sha256" },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "master_template": {
          "type": "object", "additionalProperties": false,
          "required": ["asset_id", "version", "canonical_locator", "sha256"],
          "properties": {
            "asset_id": { "const": "NOTE-HEADER-MASTER-v1.0" }, "version": { "const": "v1.0" },
            "canonical_locator": { "type": "string", "pattern": "^04_AI_Work_Environment/Visual_Production/assets/" }, "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "route_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["implementation_id", "route", "runtime_receipt_sha256"],
          "properties": {
            "implementation_id": { "const": "repo-skill:visual-production-bridge/v1" }, "route": { "const": "repository-skill-request-bound" },
            "runtime_receipt_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "asset_qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence"],
          "properties": {
            "status": { "const": "PASS" },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "human_approval": {
          "type": "object", "additionalProperties": false,
          "required": ["event_id", "evidence_sha256"],
          "properties": { "event_id": { "type": "string", "minLength": 1 }, "evidence_sha256": { "$ref": "#/$defs/sha256" } }
        }
      }
    },
    "publication_conditions": { "$ref": "#/$defs/publication_conditions" },
    "destination": { "$ref": "#/$defs/destination" },
    "purpose": { "const": "NOTE_PUBLICATION" },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "file", "sha256"],
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "PENDING" } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "file", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "publication_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_boundary", "membership", "magazine", "price", "tags", "other_conditions"],
      "properties": {
        "access_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "free_end_marker", "membership_start_marker"],
          "properties": {
            "mode": { "enum": ["FREE", "PAID", "MEMBERSHIP"] },
            "free_end_marker": { "type": "string", "minLength": 1 },
            "membership_start_marker": { "type": "string", "minLength": 1 }
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name", "plan"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" },
            "plan": { "type": "string" }
          }
        },
        "magazine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" }
          }
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "amount"],
          "properties": {
            "currency": { "const": "JPY" },
            "amount": { "type": "integer", "minimum": 0 }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "other_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "account_id", "publication_target"],
      "properties": {
        "service": { "const": "note" },
        "account_id": { "type": "string", "minLength": 1 },
        "publication_target": { "type": "string", "minLength": 1 }
      }
    }
  }
}

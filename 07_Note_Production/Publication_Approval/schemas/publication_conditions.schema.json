{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/note-publication-conditions.schema.json",
  "title": "note Publication Conditions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity_sha256", "conditions"],
  "properties": {
    "schema_version": { "const": "note-publication-conditions/v1" },
    "identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_boundary", "membership", "magazine", "price", "tags", "other_conditions"],
      "properties": {
        "access_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "free_end_marker", "membership_start_marker"],
          "properties": {
            "mode": { "enum": ["FREE", "PAID", "MEMBERSHIP"] },
            "free_end_marker": { "type": "string", "minLength": 1 },
            "membership_start_marker": { "type": "string", "minLength": 1 }
          }
        },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name", "plan"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" },
            "plan": { "type": "string" }
          }
        },
        "magazine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "name"],
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string" }
          }
        },
        "price": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "amount"],
          "properties": {
            "currency": { "const": "JPY" },
            "amount": { "type": "integer", "minimum": 0 }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "other_conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

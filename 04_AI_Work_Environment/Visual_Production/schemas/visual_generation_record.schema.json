{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/visual-generation-record-v1.json",
  "title": "Visual Generation Record v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "task_id",
    "production_version",
    "phase",
    "artifact_type",
    "source_manifest",
    "resolved_requirements",
    "generation_contract",
    "tool_route",
    "tool_request",
    "preflight",
    "asset",
    "asset_qa",
    "transition"
  ],
  "properties": {
    "schema_version": { "const": "visual-production/v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "production_version": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "source_manifest": {
      "type": "object",
      "required": ["task_id", "production_version", "result", "fingerprint_sha256", "sources"],
      "properties": {
        "result": { "const": "PASS" },
        "fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "file_sha256", "applied_to"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "file_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "applied_to": { "type": "array", "minItems": 1 }
            }
          }
        }
      }
    },
    "resolved_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "text", "source_path"],
        "properties": {
          "level": { "enum": ["MUST", "MUST_NOT", "MAY"] }
        }
      }
    },
    "generation_contract": {
      "type": "object",
      "required": ["article_id", "profile_id", "source_fingerprint_sha256", "approved_text", "dimensions", "reference_assets", "request_identity_sha256", "requirement_ids", "creative_direction", "inspection_capability", "max_automatic_retries"],
      "properties": {
        "article_id": { "type": "string", "minLength": 1 },
        "request_identity_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "contract_identity_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "invocation_arguments_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "destination": { "const": "NOTE_FINAL_REVIEW_PACKAGE" },
        "purpose": { "const": "NOTE_HEADER_ASSET_PRODUCTION" },
        "reference_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["asset_id", "version", "logical_locator", "sha256"],
            "properties": {
              "asset_id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "logical_locator": { "type": "string", "minLength": 1 },
              "manifest_locator": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "expected_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "actual_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
              "dimensions": {
                "type": "object",
                "required": ["width", "height"],
                "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
              },
              "provenance": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inspection_capability": { "enum": ["ai-visual-inspection", "human-required"] },
        "max_automatic_retries": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "tool_request": {
      "type": "object",
      "required": ["text_verbatim", "prompt", "dimensions", "referenced_image_paths", "included_requirement_ids", "negative_requirement_ids"],
      "properties": {
        "referenced_image_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tool_route": {
      "type": "object",
      "required": ["tool", "capability", "allowed", "rationale"],
      "properties": {
        "capability": { "const": "image-generation" },
        "allowed": { "type": "boolean" }
      }
    },
    "asset_qa": {
      "type": "object",
      "required": ["performed", "result", "checks"],
      "properties": {
        "result": { "enum": ["NOT_RUN", "PASS", "FAIL", "HUMAN_REQUIRED"] }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["environment", "implementation_id", "route", "state"],
      "properties": {
        "environment": { "const": "cloud-work" },
        "implementation_id": { "const": "repo-skill:visual-production-bridge/cloud-work-v2" },
        "route": { "const": "repository-cloud-work-request-bound" },
        "state": { "enum": ["REQUEST_READY", "NORMALIZED_UNVERIFIED", "ASSET_QA_PASS"] }
      }
    },
    "raw_asset": {
      "type": "object",
      "required": ["status", "provenance", "locator", "local_path", "sha256", "width", "height"],
      "properties": {
        "status": { "const": "RAW_GENERATED_UNVERIFIED" }, "provenance": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "minLength": 1 },
        "local_path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }
      }
    },
    "normalization": {
      "type": "object",
      "required": ["status", "identity_sha256", "evidence_path", "evidence_sha256", "input_sha256", "output_sha256", "tool", "version", "method"],
      "properties": {
        "status": { "const": "PASS" }, "identity_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidence_path": { "type": "string", "minLength": 1 }, "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "input_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "output_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "tool": { "const": "repository-node-png-normalizer" }, "version": { "const": "1.0.0" }, "method": { "const": "center-crop-cover-fixedpoint-bilinear-rgba8-png" }
      }
    }
  }
}

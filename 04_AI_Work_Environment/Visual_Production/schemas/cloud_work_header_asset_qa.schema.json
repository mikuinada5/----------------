{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/cloud-work-header-asset-qa-v2.json",
  "title": "Cloud Work normalized note Header Asset QA evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_origin", "environment", "inspection_tool", "inspection_event_id", "task_id", "production_version", "contract_identity_sha256", "runtime_receipt_sha256", "tool_event_sha256", "normalization_event_sha256", "raw_asset_sha256", "asset_sha256", "dimensions", "checks", "result", "performed_at"],
  "properties": {
    "schema_version": { "const": "cloud-work-header-asset-qa/v2" },
    "evidence_origin": { "const": "current-task-image-inspection-tool-event" },
    "environment": { "const": "cloud-work" },
    "inspection_tool": { "enum": ["view_image", "platform-image-inspection"] },
    "inspection_event_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "production_version": { "type": "string", "minLength": 1 },
    "contract_identity_sha256": { "$ref": "#/$defs/sha256" },
    "runtime_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "tool_event_sha256": { "$ref": "#/$defs/sha256" },
    "normalization_event_sha256": { "$ref": "#/$defs/sha256" },
    "raw_asset_sha256": { "$ref": "#/$defs/sha256" },
    "asset_sha256": { "$ref": "#/$defs/sha256" },
    "dimensions": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "const": 1280 }, "height": { "const": 670 } }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["requirement_id", "result", "evidence"],
        "properties": { "requirement_id": { "type": "string", "minLength": 1 }, "result": { "enum": ["PASS", "FAIL"] }, "evidence": { "type": "string", "minLength": 1 } }
      }
    },
    "result": { "enum": ["PASS", "FAIL"] },
    "performed_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}

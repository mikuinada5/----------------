{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/cloud-work-image-generation-event-v2.json",
  "title": "Cloud Work native image generation raw Asset event v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_origin", "environment", "event_id", "task_id", "production_version", "contract_identity_sha256", "tool", "invoked_at", "completed_at", "arguments", "arguments_sha256", "generated_asset"],
  "properties": {
    "schema_version": { "const": "cloud-work-image-generation-event/v2" },
    "evidence_origin": { "const": "current-task-cloud-work-tool-event" },
    "environment": { "const": "cloud-work" },
    "event_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "production_version": { "type": "string", "minLength": 1 },
    "contract_identity_sha256": { "$ref": "#/$defs/sha256" },
    "tool": { "const": "image_gen.imagegen" },
    "invoked_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "referenced_image_paths"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "referenced_image_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "arguments_sha256": { "$ref": "#/$defs/sha256" },
    "generated_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_path", "sha256", "tool_output_locator", "dimensions"],
      "properties": {
        "local_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "tool_output_locator": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}

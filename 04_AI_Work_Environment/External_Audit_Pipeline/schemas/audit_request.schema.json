{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/external-audit/audit-request.schema.json",
  "title": "External Audit Request Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "series_name",
    "section_number",
    "session_number",
    "article_title",
    "internal_audit",
    "external_sharing",
    "content",
    "sources"
  ],
  "properties": {
    "series_name": { "type": "string", "minLength": 1 },
    "section_number": { "type": "string", "minLength": 1 },
    "session_number": { "type": "string", "minLength": 1 },
    "article_title": { "type": "string", "minLength": 1 },
    "internal_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report_ref"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] },
        "report_ref": { "type": "string", "minLength": 1 }
      }
    },
    "external_sharing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approval_ref"],
      "properties": {
        "approved": { "type": "boolean" },
        "approval_ref": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story", "practice", "session_archive"],
      "properties": {
        "story": { "$ref": "#/$defs/sourceSpec" },
        "practice": { "$ref": "#/$defs/sourceSpec" },
        "session_archive": { "$ref": "#/$defs/sourceSpec" }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_notes",
        "series_policy",
        "session_scope",
        "downstream_boundary",
        "voice_archive_rules"
      ],
      "properties": {
        "evidence_notes": { "$ref": "#/$defs/nonEmptySourceList" },
        "series_policy": { "$ref": "#/$defs/nonEmptySourceList" },
        "session_scope": { "$ref": "#/$defs/nonEmptySourceList" },
        "downstream_boundary": { "$ref": "#/$defs/nonEmptySourceList" },
        "voice_archive_rules": { "$ref": "#/$defs/nonEmptySourceList" }
      }
    },
    "reaudit_context": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["previous_audit", "revision_summary"],
          "properties": {
            "previous_audit": { "$ref": "#/$defs/sourceSpec" },
            "revision_summary": { "$ref": "#/$defs/sourceSpec" }
          }
        }
      ]
    }
  },
  "$defs": {
    "sourceSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "start_marker": { "type": "string", "minLength": 1 },
        "end_marker": { "type": "string", "minLength": 1 },
        "max_chars": { "type": "integer", "minimum": 1, "maximum": 200000 }
      }
    },
    "nonEmptySourceList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceSpec" }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/source_manifest.schema.json",
  "title": "Source Manifest / Source QA Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "production_version",
    "repository",
    "resolution",
    "sources",
    "g2"
  ],
  "properties": {
    "schema_version": { "const": "source-manifest/v2" },
    "task_id": { "type": "string", "minLength": 1 },
    "production_version": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_commit_sha", "resolved_at"],
      "properties": {
        "resolved_commit_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "responsibility_roots", "discovered_candidates"],
      "properties": {
        "method": { "const": "responsibility-root-discovery" },
        "responsibility_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "discovered_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "decision"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "status": { "type": "string" },
              "version": { "type": "string" },
              "decision": { "enum": ["selected", "excluded"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "responsibility",
          "required",
          "status",
          "version_or_revision",
          "file_sha256",
          "read_by",
          "read_at",
          "read_task_id",
          "read_scope",
          "applied_to",
          "dependencies",
          "dependency_check",
          "conflict_check"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "responsibility": { "type": "string", "minLength": 1 },
          "required": { "enum": ["required", "conditional"] },
          "status": { "type": "string", "pattern": "Current" },
          "version_or_revision": { "type": "string", "minLength": 1 },
          "file_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "read_by": { "type": "string", "minLength": 1 },
          "read_at": { "type": "string", "format": "date-time" },
          "read_task_id": { "type": "string", "minLength": 1 },
          "read_scope": { "type": "string", "minLength": 1 },
          "applied_to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "dependency_check": { "const": "PASS" },
          "conflict_check": { "const": "PASS" }
        }
      }
    },
    "g2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_complete",
        "current_canonical_unique",
        "dependency_closure_complete",
        "same_task_read_complete",
        "source_fingerprint_frozen",
        "result",
        "passed_at"
      ],
      "properties": {
        "resolution_complete": { "const": true },
        "current_canonical_unique": { "const": true },
        "dependency_closure_complete": { "const": true },
        "same_task_read_complete": { "const": true },
        "source_fingerprint_frozen": { "const": true },
        "result": { "const": "PASS" },
        "passed_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

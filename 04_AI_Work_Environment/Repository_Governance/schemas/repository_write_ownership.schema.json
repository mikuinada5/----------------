{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository.local/schemas/repository-write-ownership-v1.json",
  "title": "Repository write ownership matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matrix_version", "default_policy", "domains"],
  "properties": {
    "schema_version": { "const": "repository-write-ownership/v1" },
    "matrix_version": { "const": "v1.0" },
    "default_policy": { "const": "DENY" },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "mode"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "owner": { "enum": ["cloud-work", "local-codex"] },
          "mode": { "enum": ["append-only-new-article", "maintain"] },
          "path_prefix": { "type": "string", "minLength": 2 },
          "exact_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "oneOf": [
          { "required": ["path_prefix"], "not": { "required": ["exact_paths"] } },
          { "required": ["exact_paths"], "not": { "required": ["path_prefix"] } }
        ]
      }
    }
  }
}
